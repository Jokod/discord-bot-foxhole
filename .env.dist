APP_ENV=prod
TZ=Europe/Paris
PREFIX=!

TOKEN="your-bot-token"
CLIENT_ID="bot-id"

OWNER="owner-id"
TEST_GUILD_ID="dev-server-id"

MONGODB_URL="mongodb://localhost:27017"
MONGODB_NAME="foxhole-bot"

# Optional — Docker image pin (default: latest)
# FOXBOT_IMAGE_TAG=1.0.0

# Optional: IDs de serveurs où le bot ne doit pas rester (séparés par des virgules). Si le bot est déjà dedans, il se retire.
# BLOCKED_GUILD_IDS=123456789,987654321

# Optional — used by /about (FR: /a-propos)
# Leave empty to hide a link from the command reply.
GITHUB_URL="https://github.com/Jokod/discord-bot-foxhole"
# Optional override; defaults to GITHUB_URL/issues/new
# GITHUB_ISSUES_URL="https://github.com/Jokod/discord-bot-foxhole/issues/new"
DISCORD_INVITE_URL="https://discord.gg/bjkzG9YsX5"
