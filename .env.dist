APP_ENV=prod
TZ=Europe/Paris
PREFIX=!

TOKEN="your-bot-token"
CLIENT_ID="bot-id"

OWNER="owner-id"
TEST_GUILD_ID="dev-server-id"

MONGODB_URL="mongodb://localhost:27017"
MONGODB_NAME="foxhole-bot"

# Optional — Docker image pin (default: latest)
# FOXBOT_IMAGE_TAG=1.0.0

# Optional — local Mongo via Compose (profile with-mongo). Prefer Atlas in production.
# MONGO_ROOT_USERNAME=foxbot
# MONGO_ROOT_PASSWORD=change-me
# MONGODB_URL=mongodb://foxbot:change-me@mongo:27017/?authSource=admin
# COMPOSE_PROFILES=with-mongo
# Full stack example: COMPOSE_PROFILES=with-mongo,dashboard

# Optional — public URL when reverse-proxied (nginx, Caddy, Traefik, …)
# DASHBOARD_PUBLIC_ORIGIN=https://stats.example.com
# Optional — cookie Secure (auto-on when DASHBOARD_PUBLIC_ORIGIN is https://…; set 0 to force off)
# DASHBOARD_COOKIE_SECURE=1
# Optional — trust X-Forwarded-For from your reverse proxy only (rate-limit client IP)
# DASHBOARD_TRUST_PROXY=1

# Optional: IDs de serveurs où le bot ne doit pas rester (séparés par des virgules). Si le bot est déjà dedans, il se retire.
# BLOCKED_GUILD_IDS=123456789,987654321

# Optional — used by /about (FR: /a-propos)
# Leave empty to hide a link from the command reply.
GITHUB_URL="https://github.com/Jokod/discord-bot-foxhole"
# Optional override; defaults to GITHUB_URL/issues/new
# GITHUB_ISSUES_URL="https://github.com/Jokod/discord-bot-foxhole/issues/new"
DISCORD_INVITE_URL="https://discord.gg/bjkzG9YsX5"
