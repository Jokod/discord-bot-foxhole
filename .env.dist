# Copy to .env and fill in values:
#   cp .env.dist .env

# —— Runtime ————————————————————————————————————————————————————————————————
APP_ENV=prod
TZ=Europe/Paris

# —— Discord (required) —————————————————————————————————————————————————————
TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Required when APP_ENV=dev (guild slash registration)
TEST_GUILD_ID=your-dev-guild-id

# —— MongoDB (required) —————————————————————————————————————————————————————
# Atlas / external (recommended in production):
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=foxhole-bot

# —— Docker Compose (optional) ——————————————————————————————————————————————
# Pin image: FOXBOT_IMAGE_TAG=1.0.0
# FOXBOT_IMAGE_TAG=latest

# Local Mongo (profile with-mongo). Prefer Atlas in production.
# MONGO_ROOT_USERNAME=foxbot
# MONGO_ROOT_PASSWORD=change-me
# MONGODB_URL=mongodb://foxbot:change-me@mongo:27017/?authSource=admin
# MONGODB_NAME=foxhole-bot
# COMPOSE_PROFILES=with-mongo
# Full stack: COMPOSE_PROFILES=with-mongo,dashboard
# NAS / CPU without AVX: MONGO_IMAGE=mongo:4.4  (default mongo:7)
# MONGO_IMAGE=mongo:4.4

# —— Dashboard (optional, profile dashboard) ————————————————————————————————
# Publish port mapping (default 3847 on all interfaces):
#   DASHBOARD_PUBLISH=3847
#   DASHBOARD_PUBLISH=127.0.0.1:3847
# DASHBOARD_PUBLISH=3847
# Behind a reverse proxy:
# DASHBOARD_PUBLIC_ORIGIN=https://stats.example.com
# DASHBOARD_COOKIE_SECURE=1
# DASHBOARD_TRUST_PROXY=1

# —— Bot extras (optional) ——————————————————————————————————————————————————
# BLOCKED_GUILD_IDS=123456789,987654321
GITHUB_URL=https://github.com/Jokod/discord-bot-foxhole
# GITHUB_ISSUES_URL=https://github.com/Jokod/discord-bot-foxhole/issues/new
DISCORD_INVITE_URL=https://discord.gg/bjkzG9YsX5
