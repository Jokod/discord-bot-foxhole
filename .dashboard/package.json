{
	"name": "foxbot-dashboard",
	"version": "1.0.7",
	"private": true,
	"description": "FoxBot maintainer stats dashboard",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "node server.js",
		"dev": "node server.js",
		"dev:local": "DASHBOARD_ENV_FILE=../.env node server.js",
		"web:dev": "vite --config web/vite.config.ts",
		"build": "vue-tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
		"test": "vitest run --config web/vitest.config.ts",
		"test:watch": "vitest --config web/vitest.config.ts",
		"lint": "eslint . && eslint -c eslint.web.config.js web",
		"fix": "eslint --fix . && eslint -c eslint.web.config.js --fix web"
	},
	"dependencies": {
		"@fontsource/fraunces": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.0",
		"chart.js": "^4.4.8",
		"dotenv": "^17.3.1",
		"pinia": "^4.0.3",
		"swagger-ui-dist": "^5.32.14",
		"vue": "^3.5.41",
		"vue-chartjs": "^5.3.4",
		"vue-i18n": "^11.4.2",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.3.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"eslint": "^10.0.2",
		"eslint-plugin-vue": "^10.4.0",
		"happy-dom": "^20.11.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.11"
	}
}
